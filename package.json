{
  "name": "zafar-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node blog/build.mjs && NODE_OPTIONS='--max-old-space-size=8192' nuxt build",
    "deploy": "node blog/build.mjs && nuxt build && cf-wrangler build && cf deploy --prebuilt",
    "dev": "node blog/build.mjs && nuxt dev",
    "blog": "node blog/build.mjs",
    "blog:watch": "node blog/build.mjs --watch",
    "generate": "node blog/build.mjs && NODE_OPTIONS='--max-old-space-size=8192' nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/simple-icons": "^1.2.85",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/i18n": "^10.0.3",
    "@takumi-rs/core": "^1.7.0",
    "@vueuse/nuxt": "^14.3.0",
    "marked": "^17.0.6",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.8",
    "nuxt-og-image": "^6.5.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "cf": "^1.0.0-beta.5",
    "eslint": "^10.4.1",
    "shiki": "^4.2.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.3",
    "wrangler": "^4.144.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "bun@1.2.10"
}
