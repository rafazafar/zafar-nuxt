{
  // zafar.dev is static files only: public/ (the homepage, the generated blog, images).
  // No Worker script. The live photo pile talks to the separate worker in party/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafazafar-zafar-nuxt",
  "account_id": "e8e4e405b53eee172786886b66ed2e93",
  "compatibility_date": "2026-05-26",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
