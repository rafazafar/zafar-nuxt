{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zafar-nuxt",
  "compatibility_date": "2026-05-26",
  "main": "./.output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  }
}